# OrionDB. Leave unset to use the local orion-db container (docker compose).
# On the host, the local container is: postgresql://orion:orion@localhost:5434/orion
ORION_DATABASE_URL=
# Read-only source: real Penelope (needs VPN) OR penelope2 (Neon). Same code either way.
PENELOPE_DATABASE_URL=
# Backup copy of Penelope, filled by `orion-pipeline sync`. Same tables as Penelope, so
# if Penelope goes down, set PENELOPE_DATABASE_URL to this.
PENELOPE_COPY_DATABASE_URL=
# Max page size for each pipeline step. Defaults to 100,000
PIPELINE_PAGE_SIZE=
# GPS lag correction, in seconds, for sensors flagged gps_lagged in sensor_catalog.py.
# corrected time = Penelope time + offset: positive moves timestamps later.
# Set to 0 to turn the correction off. Defaults to 3
GPS_TIME_OFFSET_S=
# Lap detection tunables (docs/lap_detection.md). Leave unset for the defaults.
# Hitbox radius around remembered points, in meters. Defaults to 3
LAP_HITBOX_RADIUS_M=
# Minimum time / distance driven before a revisit counts. Default 5 s / 50 m
LAP_MIN_REVISIT_TIME_S=
LAP_MIN_REVISIT_DISTANCE_M=
# The gate search only looks at every Nth point. Defaults to 5
LAP_GATE_SEARCH_SAMPLE_EVERY=
# Gate reach on each side of its center, in meters. Defaults to 5
LAP_GATE_HALF_WIDTH_M=
# Minimum time between two counted gate crossings, in seconds. Defaults to 10
LAP_MIN_LAP_TIME_S=

# ---- Frontend ----
# Where the Vite dev server forwards the browser's /api requests.
# Defaults to http://localhost:8100 (orion-backend from docker compose).
# docker compose sets this to http://orion-backend:8000 for the frontend container.
API_PROXY_TARGET=